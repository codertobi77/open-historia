# Web-mode build (the website served from the trusted central origin).
# Loaded by the web build (`vite --mode web` — bun run dev:web / build:web /
# build:site), the only surviving build mode.
VITE_OH_WEB=1

# The website can't host the 60-100 MB pmtiles itself, so map tiles load from
# the registry Worker's CORS+range proxy, which streams them from the canonical
# GitHub Release. Nodes (when published) are tried first and verified by hash;
# this is the always-available fallback.
VITE_OH_PMTILES_URL=https://open-historia-registry.nichojkrol.workers.dev/content

# Use the LIVE signed node directory from the registry Worker (updates as nodes
# are accepted/paused/banned), not the stale copy bundled at build time.
VITE_OH_DIRECTORY_URL=https://open-historia-registry.nichojkrol.workers.dev/node-directory.json

# Community hub GitHub proxy (SSRF-guarded /hub/file on the registry Worker) —
# GitHub attachments/release assets send no CORS headers, so bundle downloads
# must go through it. Listing still hits api.github.com directly.
VITE_OH_HUB_URL=https://open-historia-registry.nichojkrol.workers.dev

# Accounts + encrypted sync (Google sign-in identity; games/scenarios sync as
# blobs encrypted client-side). Points at the registry Worker's /account/* + /sync/*.
VITE_OH_ACCOUNT_URL=https://open-historia-registry.nichojkrol.workers.dev

# "Sign in with Google" OAuth client id (public — safe to ship in the client).
# Create one at console.cloud.google.com → APIs & Services → Credentials → OAuth
# client ID (Web application), with openhistoria.com as an authorized JS origin.
# Empty = the Google sign-in button is hidden (accounts disabled) until it's set.
VITE_OH_GOOGLE_CLIENT_ID=307274975258-7mh0hi4jjc7tv0br87ih8qok3f7l410v.apps.googleusercontent.com
